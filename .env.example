# kotoba settings. Copy this file to .env and uncomment what you need:
#   cp .env.example .env
# Docker Compose (make up) and local runs (make run, make dev) both read .env.
# Everything is optional; the Add-ons page shows what is set up.

# --- the server ---------------------------------------------------------------
# Port on this machine
# KOTOBA_PORT=8780
# Extra host names allowed to reach kotoba, comma-separated (e.g. for tailscale serve)
# KOTOBA_HOSTS=pi.tail1234.ts.net
# Your time zone, for "today" in practice counts
# TZ=Europe/Paris
# Where the database and files live (local runs; Docker uses its kotoba-data volume)
# KOTOBA_DATA=/home/me/.local/share/kotoba

# --- Whisper: speaking scores and transcription ---------------------------------
# Empty picks by itself: large-v3 on a GPU, large-v3-turbo on a CPU
# KOTOBA_WHISPER_MODEL=large-v3-turbo
# KOTOBA_WHISPER_DEVICE=cuda
# KOTOBA_WHISPER_COMPUTE=int8

# --- Voices -------------------------------------------------------------------
# A VOICEVOX or AivisSpeech engine (AivisSpeech uses port 10101)
# KOTOBA_VOICEVOX=http://127.0.0.1:50021

# --- Translations ---------------------------------------------------------------
# Easier: add translators on the Add-ons page. These set the default one.
# An OpenAI-compatible server (Ollama, llama-server, LM Studio, OpenRouter, OpenAI…),
# or "anthropic" for Claude. Under Docker, a server on this machine is at
# host.docker.internal, not 127.0.0.1 (Docker's default is Ollama there).
# KOTOBA_LLM_URL=http://127.0.0.1:11434/v1
# Empty takes the first model the server lists
# KOTOBA_LLM_MODEL=qwen2.5:7b
# KOTOBA_LLM_KEY=
# ANTHROPIC_API_KEY=

# --- Dictionary -------------------------------------------------------------------
# Language of the word lookup glosses: eng, fre, ger, spa, rus…
# KOTOBA_DICT_LANG=eng
